{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "manef-diagram-pilot",
	"account_id": "6f4d69d8b0aad48ef1da4c3724d84711",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-11",
	"compatibility_flags": ["nodejs_compat"],
	"minify": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"env": {
		"pilot": {
			"name": "manef-diagram-pilot",
			"workers_dev": true,
			"preview_urls": false,
			"secrets": { "required": ["MCP_SERVER_TOKEN"] },
			"vars": {
				"PUBLIC_SITE_URL": "https://manef-diagram-pilot.manef-pilot-6f4d69.workers.dev",
				"PUBLIC_SEO_INDEXABLE": "false",
				"PUBLIC_CONVEX_URL": "https://dutiful-zebra-689.convex.cloud",
				"AUTH_ENABLED": "false",
				"AUTH_PROVIDER": "workos",
				"WORKOS_CLIENT_ID": "client_01M3X9NDW4TE0P8DN6XS246PVM",
				"MCP_SERVER_ENABLED": "true",
				"MCP_CLIENT_ENABLED": "false",
				"AI_ENABLED": "false"
			}
		}
	}
}
