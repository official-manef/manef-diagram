{
	"name": "manef-diagram",
	"private": true,
	"version": "0.1.0",
	"description": "Reusable MANEF architecture inventory and graph explorer for SvelteKit and Next.js consumers.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/official-manef/manef-diagram.git"
	},
	"bugs": {
		"url": "https://github.com/official-manef/manef-diagram/issues"
	},
	"homepage": "https://diagram.manef.dev",
	"keywords": [
		"manef",
		"architecture",
		"graph",
		"inventory",
		"svelte",
		"sveltekit",
		"convex",
		"typescript",
		"modular-feature"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/convex && node scripts/version.mjs --check && bun run assets:check && bun run check:n8n && bun run check:core",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && bun run lint:svelte5",
		"lint:svelte5": "node scripts/check-svelte5.mjs",
		"format": "prettier --write .",
		"assets:generate": "bun scripts/assets.ts generate",
		"assets:check": "bun scripts/assets.ts check",
		"assets:prompts": "bun scripts/assets.ts prompts",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:dev": "playwright test --config playwright.dev.config.ts",
		"test": "bun run test:unit",
		"convex:dev": "convex dev",
		"convex:codegen": "convex codegen",
		"build:deploy": "bun scripts/deploy.mjs",
		"version:bump": "node scripts/version.mjs",
		"verify": "bun run check && bun run lint && bun run test && bun run build",
		"test:notes": "playwright test --config playwright.notes.config.ts",
		"build:n8n": "bun scripts/build-n8n-converter.mjs",
		"check:n8n": "bun scripts/build-n8n-converter.mjs --check",
		"check:core": "tsc --noEmit -p tests/fixtures/core/tsconfig.json",
		"env:check": "node scripts/env-check.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@convex-dev/eslint-plugin": "4.0.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "1.62.1",
		"@resvg/resvg-js": "2.6.2",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/adapter-vercel": "7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^22.20.5",
		"convex-test": "0.0.56",
		"eslint": "10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "1.5.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "4.1.11",
		"wrangler": "4.149.0"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2 <2",
		"node": "^22.23.2 || ^24.15.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.49",
		"@ai-sdk/google": "4.0.64",
		"@ai-sdk/openai": "4.0.60",
		"@lucide/svelte": "^1.62.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"ai": "7.0.93",
		"bits-ui": "2.19.0",
		"convex": "1.48.0",
		"convex-svelte": "0.14.0",
		"jose": "6.2.12",
		"mermaid": "^12.2.0",
		"openid-client": "6.8.8",
		"zod": "4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
